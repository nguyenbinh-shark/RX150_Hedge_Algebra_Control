+bool DynamixelDriver::addFastSyncReadHandler(uint16_t address, uint16_t length, const char **log)
+{
+  if (!addSyncReadHandler(address, length, log))
+    return false;
+
+  uint8_t idx = sync_read_handler_cnt_ - 1;
+  syncReadHandler_[idx].groupFastSyncRead = new dynamixel_workbench_toolbox::GroupFastSyncReadChecked(
+    portHandler_, packetHandler_, address, length);
+  syncReadHandler_[idx].fast_enabled = true;
+  syncReadHandler_[idx].activeRead = syncReadHandler_[idx].groupFastSyncRead;
+  return true;
+}
+
+bool DynamixelDriver::addFastSyncReadHandler(uint8_t id, const char *item_name, const char **log)
+{
+  if (!addSyncReadHandler(id, item_name, log))
+    return false;
+
+  uint8_t idx = sync_read_handler_cnt_ - 1;
+  const ControlItem *control_item = syncReadHandler_[idx].control_item;
+  if (control_item != NULL)
+  {
+    syncReadHandler_[idx].groupFastSyncRead = new dynamixel_workbench_toolbox::GroupFastSyncReadChecked(
+      portHandler_, packetHandler_, control_item->address, control_item->data_length);
+    syncReadHandler_[idx].fast_enabled = true;
+    syncReadHandler_[idx].activeRead = syncReadHandler_[idx].groupFastSyncRead;
+  }
+  return true;
+}
+
+bool DynamixelDriver::probeFastSyncRead(uint8_t index, uint8_t *id, uint8_t id_num, const char **log)
+{
+  if (index >= sync_read_handler_cnt_ || syncReadHandler_[index].groupFastSyncRead == NULL)
+  {
+    if (log != NULL) *log = "Fast sync read handler not available";
+    return false;
+  }
+
+  syncReadHandler_[index].groupFastSyncRead->clearParam();
+  for (int i = 0; i < id_num; i++)
+  {
+    syncReadHandler_[index].groupFastSyncRead->addParam(id[i]);
+  }
+  int res = syncReadHandler_[index].groupFastSyncRead->txRxPacket();
+  if (res == COMM_SUCCESS)
+  {
+    syncReadHandler_[index].fast_enabled = true;
+    syncReadHandler_[index].activeRead = syncReadHandler_[index].groupFastSyncRead;
+    if (log != NULL) *log = "Fast Sync Read probe SUCCEEDED";
+    return true;
+  }
+  else
+  {
+    syncReadHandler_[index].fast_enabled = false;
+    syncReadHandler_[index].activeRead = syncReadHandler_[index].groupSyncRead;
+    if (log != NULL) *log = packetHandler_->getTxRxResult(res);
+    return false;
+  }
+}
+
+bool DynamixelDriver::isSyncReadFast(uint8_t index) const
+{
+  if (index >= sync_read_handler_cnt_) return false;
+  return syncReadHandler_[index].fast_enabled;
+}
+
+uint32_t DynamixelDriver::getSyncReadFallbackCount(uint8_t index) const
+{
+  if (index >= sync_read_handler_cnt_) return 0;
+  return syncReadHandler_[index].fast_fallback_total;
+}
