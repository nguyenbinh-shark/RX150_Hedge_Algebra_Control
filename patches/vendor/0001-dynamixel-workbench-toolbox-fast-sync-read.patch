+#ifndef DYNAMIXEL_WORKBENCH_TOOLBOX_PORT_HANDLER_LOW_LATENCY_H
+#define DYNAMIXEL_WORKBENCH_TOOLBOX_PORT_HANDLER_LOW_LATENCY_H
+
+#include <cstdlib>
+#include <dynamixel_sdk/port_handler_linux.h>
+
+namespace dynamixel_workbench_toolbox
+{
+
+class PortHandlerLowLatency : public dynamixel::PortHandlerLinux
+{
+public:
+  explicit PortHandlerLowLatency(const char *port_name)
+    : dynamixel::PortHandlerLinux(port_name),
+      latency_ms_(1.0)
+  {
+    const char *env_latency = std::getenv("DXL_LATENCY_MS");
+    if (env_latency != nullptr)
+    {
+      double val = std::atof(env_latency);
+      if (val > 0.0)
+      {
+        latency_ms_ = val;
+      }
+    }
+  }
+
+  virtual ~PortHandlerLowLatency() {}
+
+  void setPacketTimeout(uint16_t packet_length) override
+  {
+    int baud = getBaudRate();
+    double tx_time_per_byte = (baud > 0) ? ((1000.0 / static_cast<double>(baud)) * 10.0) : 0.01;
+    double timeout_ms = (tx_time_per_byte * static_cast<double>(packet_length)) + (latency_ms_ * 2.0) + 1.0;
+    dynamixel::PortHandlerLinux::setPacketTimeout(timeout_ms);
+  }
+
+  void setPacketTimeout(double msec) override
+  {
+    dynamixel::PortHandlerLinux::setPacketTimeout(msec);
+  }
+
+  double getLatencyMs() const { return latency_ms_; }
+  void setLatencyMs(double ms) { latency_ms_ = ms; }
+
+private:
+  double latency_ms_;
+};
+
+}  // namespace dynamixel_workbench_toolbox
+
+#endif // DYNAMIXEL_WORKBENCH_TOOLBOX_PORT_HANDLER_LOW_LATENCY_H
+
