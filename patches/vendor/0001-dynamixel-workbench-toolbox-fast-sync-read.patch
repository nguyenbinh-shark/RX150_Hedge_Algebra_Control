+#include "dynamixel_workbench_toolbox/group_fast_sync_read_checked.h"
+#include <cstdlib>
+
+namespace dynamixel_workbench_toolbox
+{
+
+static const int RXPACKET_MAX_LEN = 1024;
+static const int PKT_ID = 4;
+static const int PKT_PARAMETER0 = 8;
+
+GroupFastSyncReadChecked::GroupFastSyncReadChecked(
+  dynamixel::PortHandler *port,
+  dynamixel::PacketHandler *ph,
+  uint16_t start_address,
+  uint16_t data_length)
+: dynamixel::GroupSyncRead(port, ph, start_address, data_length)
+{
+  clearParam();
+}
+
+int GroupFastSyncReadChecked::txPacket()
+{
+  if ((1.0 == ph_->getProtocolVersion()) || (id_list_.empty()))
+    return COMM_NOT_AVAILABLE;
+
+  if ((true == is_param_changed_) || (0 == param_))
+    makeParam();
+
+  return ph_->fastSyncReadTx(port_, start_address_, data_length_, param_, static_cast<uint16_t>(id_list_.size()));
+}
+
+int GroupFastSyncReadChecked::rxPacket()
+{
+  last_result_ = false;
+
+  if ((1.0 == ph_->getProtocolVersion()) || (id_list_.empty()))
+    return COMM_NOT_AVAILABLE;
+
+  int count = static_cast<int>(id_list_.size());
+  int result = COMM_RX_FAIL;
+  uint8_t *rxpacket = static_cast<uint8_t *>(std::malloc(RXPACKET_MAX_LEN));
+  if (rxpacket == nullptr)
+    return result;
+
+  do {
+    result = ph_->rxPacket(port_, rxpacket, true);
+  } while ((COMM_SUCCESS == result) && (BROADCAST_ID != rxpacket[PKT_ID]));
+
+  if ((COMM_SUCCESS == result) && (BROADCAST_ID == rxpacket[PKT_ID])) {
+    int index = PKT_PARAMETER0;
+    bool corrupt = false;
+    for (int i = 0; i < count; ++i) {
+      uint8_t expected_id = id_list_[i];
+      uint8_t actual_id = rxpacket[index + 1];
+      if (actual_id != expected_id) {
+        corrupt = true;
+        break;
+      }
+      *error_list_[expected_id] = static_cast<uint8_t>(rxpacket[index]);
+      for (uint16_t s = 0; s < data_length_; s++) {
+        data_list_[expected_id][s] = rxpacket[index + 2 + s];
+      }
+      index += (data_length_ + 4);
+    }
+    if (corrupt) {
+      result = COMM_RX_CORRUPT;
+      last_result_ = false;
+    } else {
+      last_result_ = true;
+    }
+  }
+
+  std::free(rxpacket);
+  return result;
+}
+
+int GroupFastSyncReadChecked::txRxPacket()
+{
+  if (1.0 == ph_->getProtocolVersion())
+    return COMM_NOT_AVAILABLE;
+
+  int result = txPacket();
+  if (COMM_SUCCESS != result)
+    return result;
+  return rxPacket();
+}
+
+}  // namespace dynamixel_workbench_toolbox
+
