# ── Colcon / ROS 2 build artifacts ────────────────────────────────────────────
# KHÔNG neo "/": bản lồng trong package (src/rx150_pick_place/build/ …) từng lọt
# lưới suốt vì "/build/" chỉ khớp ở gốc workspace.
build/
install/
log/
.pytest_cache/

# ── Vendor Interbotix + third-party ───────────────────────────────────────────
# Không commit; khôi phục bằng:  vcs import src/vendor < rx150.repos
/src/vendor/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc

# ── Compiled object files ─────────────────────────────────────────────────────
*.o

# ── Machine-local ─────────────────────────────────────────────────────────────
.vscode/*.db*
.claude/settings.local.json

# ── Dữ liệu chạy thật: bag + gói chẩn đoán (tools/record_pickplace.sh, collect_diag.sh)
/bags/
/diag_*/
/diag_*.tar.gz
frames.pdf
frames.gv
