# ── Colcon / ROS 2 build artifacts ────────────────────────────────────────────
# KHÔNG neo "/": bản lồng trong package (src/rx150_pick_place/build/ …) từng lọt
# lưới suốt vì "/build/" chỉ khớp ở gốc workspace.
build/
install/
log/
.pytest_cache/

# ── Vendor Interbotix + third-party ───────────────────────────────────────────
# Không commit; khôi phục bằng:  vcs import src/vendor < rx150.repos
/src/vendor/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc

# ── Compiled object files ─────────────────────────────────────────────────────
*.o

# ── Machine-local ─────────────────────────────────────────────────────────────
.vscode/*.db*
.claude/settings.local.json

# ── Dữ liệu chạy thật: bag + gói chẩn đoán (tools/record_pickplace.sh, collect_diag.sh)
/bags/
/diag_*/
/diag_*.tar.gz
frames.pdf
frames.gv

# ── Dữ liệu tuning: thô ở lại máy, bản tổng kết thì commit ────────────────────
# Mỗi lần ./rx150.sh record đẻ 2 CSV (traj + det) chiếm ~98% dung lượng, còn
# meta.json + *.png + summary.txt mới là thứ trích vào báo cáo. Ignore CSV để
# tuning_runs/ không phình lại như đợt 09-11/09 (50 MB).
tuning_runs/**/*.csv

# Output của compare_fuzzy_vs_hac.py và plot_hac_velocity_analysis.py — sinh lại
# được hoàn toàn bằng tính toán, không cần robot. Lệnh: xem docs/tuning/README.md
docs/tuning/*.png
docs/tuning/comparison_data.csv
