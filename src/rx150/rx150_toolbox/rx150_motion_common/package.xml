<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rx150_motion_common</name>
  <version>1.0.0</version>
  <description>Common infrastructure &amp; tools for rx150 motion controllers (fuzzy + ff): trajectory bridge, tuning GUI, motor config, sensors_3d, env-hooks. KHÔNG có lib C++ — mỗi controller compile engine riêng.</description>
  <maintainer email="nguyenbinh@example.com">nguyenbinh</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>python3-tk</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>interbotix_xs_msgs</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
