  - Class: rviz_default_plugins/InteractiveMarkers
    Enable Transparency: true
    Enabled: false
    Interactive Markers Namespace: ''
    Name: InteractiveMarkers
    Show Axes: false
    Show Descriptions: true
    Show Visual Aids: false
    Value: false
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 0.3053925633430481
      Min Value: -0.7798252105712891
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: RGB8
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 4096
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: RawPointCloud
    Position Transformer: XYZ
    Selectable: false
    Size (Pixels): 3
    Size (m): 0.009999999776482582
    Style: Points
    Topic:
      Depth: 1
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /camera/camera/depth/color/points
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: YoloMarkers
    Namespaces:
      tube_labels: true
      tube_orientation: true
      workspace_roi: true
      workspace_roi_edges: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /yolo/markers
    Value: true
  - Class: rviz_default_plugins/TF
    Enabled: false
    Frame Timeout: 15
    Frames:
      All Enabled: true
      camera_color_frame:
        Value: true
      camera_color_optical_frame:
        Value: true
      camera_depth_frame:
        Value: true
      camera_depth_optical_frame:
        Value: true
      camera_link:
        Value: true
      rx150/ar_tag_link:
        Value: true
      rx150/base_link:
        Value: true
      rx150/ee_arm_link:
        Value: true
      rx150/ee_gripper_link:
        Value: true
      rx150/fingers_link:
        Value: true
      rx150/forearm_link:
        Value: true
      rx150/gripper_bar_link:
        Value: true
      rx150/gripper_link:
        Value: true
      rx150/gripper_prop_link:
        Value: true
      rx150/left_finger_link:
        Value: true
      rx150/right_finger_link:
        Value: true
      rx150/shoulder_link:
        Value: true
      rx150/upper_arm_link:
        Value: true
      rx150/wrist_link:
        Value: true
      world:
        Value: true
    Marker Scale: 1
    Name: TF
    Show Arrows: true
    Show Axes: true
    Show Names: false
    Tree:
      camera_link:
        camera_color_frame:
          camera_color_optical_frame:
            world:
              rx150/base_link:
                rx150/shoulder_link:
                  rx150/upper_arm_link:
                    rx150/forearm_link:
                      rx150/wrist_link:
                        rx150/gripper_link:
                          rx150/ee_arm_link:
                            rx150/ar_tag_link: {}
                            rx150/gripper_bar_link:
                              rx150/fingers_link:
                                rx150/ee_gripper_link: {}
                                rx150/left_finger_link: {}
                                rx150/right_finger_link: {}
                            rx150/gripper_prop_link: {}
        camera_depth_frame:
          camera_depth_optical_frame: {}
    Update Interval: 0
    Value: true
  - Class: rviz_default_plugins/Image
    Enabled: true
    Max Value: 1
    Median window: 5
    Min Value: 0
    Name: YoloDebug
    Normalize Range: true
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /yolo/image_debug
