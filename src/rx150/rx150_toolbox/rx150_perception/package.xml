<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rx150_perception</name>
  <version>0.3.0</version>
  <description>Pipeline nhận diện PCL chuẩn Interbotix cho RX150 + RealSense D435i. Tích hợp pc_filter + armtag + static_trans_pub.</description>
  <maintainer email="trannguyenbinh.shark@gmail.com">Tran Nguyen Binh</maintainer>
  <author email="trannguyenbinh.shark@gmail.com">Tran Nguyen Binh</author>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS Python runtime -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>

  <!-- Interbotix SDK + perception modules (chuẩn upstream) -->
  <exec_depend>interbotix_common_modules</exec_depend>
  <exec_depend>interbotix_xs_modules</exec_depend>
  <exec_depend>interbotix_perception_modules</exec_depend>
  <exec_depend>interbotix_perception_msgs</exec_depend>
  <exec_depend>interbotix_tf_tools</exec_depend>
  <exec_depend>interbotix_xsarm_perception</exec_depend>

  <!-- Camera + AprilTag -->
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>apriltag_ros</exec_depend>

  <!-- Visualization -->
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
