# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,c,h,cpp,hpp}]
indent_size = 4

[*.{c,h,cpp,hpp}]
max_line_length = 100

[*.py]
max_line_length = 99

[*.{yaml,yml,xml,launch.py}]
indent_size = 2

[{CMakeLists.txt,*.cmake}]
indent_size = 2

# Hai khoảng trắng cuối dòng = ngắt dòng trong Markdown, đừng cắt.
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
